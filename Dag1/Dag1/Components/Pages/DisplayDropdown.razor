@using Dag1.Components.Pages.Tables
@using Dag1.Infrastructure
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<DbpDag1Context> DbFactory

<EnumInput TEnum="Tables" Class="mb-2" @Value="@_selectedValue" ValueChanged="OnValueChanged"></EnumInput>

@if (SelectedEnum == Tables.Author)
{
    <AuthorTable UpdateDatabaseService="UpdateDatabaseService" />
}

@if (SelectedEnum == Tables.Books)
{
    <BookTable UpdateDatabaseService="UpdateDatabaseService" />
}

@if (SelectedEnum == Tables.Bookshelf)
{
    <BookshelfTable UpdateDatabaseService="UpdateDatabaseService" />
}

@if (SelectedEnum == Tables.Format)
{
    <FormatTable UpdateDatabaseService="UpdateDatabaseService" />
}

@if (SelectedEnum == Tables.Genre)
{
    <GenreTable UpdateDatabaseService="UpdateDatabaseService" />
}

@if (SelectedEnum == Tables.Publisher)
{
    <PublisherTable UpdateDatabaseService="UpdateDatabaseService" />
}

@if (SelectedEnum == Tables.User)
{
    <UserTable UpdateDatabaseService="UpdateDatabaseService" />
}

@code {
    [Parameter, EditorRequired]
    public EventCallback UpdateDatabaseService { get; set; }
    
    protected override void OnInitialized()
    {
        SetSelectedEnum();
        
        base.OnInitialized();
    }

    private int _selectedValue = (int)Tables.Choose;

    private Tables SelectedEnum { get; set; }

    private void SetSelectedEnum()
    {
        SelectedEnum = (Tables)_selectedValue;
    }

    private void OnValueChanged(int value)
    {
        _selectedValue = value;
        
        SetSelectedEnum();
    }
    
    private enum Tables
    {
        Choose,
        Author,
        Books,
        Bookshelf,
        Format,
        Genre,
        Publisher,
        User
    }
}