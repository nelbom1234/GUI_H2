@page "/"
@rendermode InteractiveServer

<div class="top-row px-4 d-flex justify-content-end">
    <InputSelect @bind-Value="Language">
        <option selected value="Dansk">Dansk</option>
        <option value="English">English</option>
    </InputSelect>
    <a href="" class="px-2">Home</a>
    <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
</div>

<PageTitle>Home</PageTitle>
<div class="container d-flex justify-content-center text-center">
    <div class="row">
        <div class="col">
            <div class="row">
                <div class="col">
                    @if (Language == "Dansk")
                    {
                        <h1>Database oversigt</h1>
                    }
                    @if (Language == "English")
                    {
                        <h1>Database overview</h1>
                    }
                </div>
            </div>
            <hr />
            <div class="row">
                <div class="col">
                    <DisplayDropdown UpdateDatabaseService="UpdateDatabaseService"/>
                    <DatabaseService @ref="_databaseService"/>
                </div>
            </div>
            
        </div>
    </div>
</div>

@code {
    private string Language = "Dansk";

    private DatabaseService _databaseService = null!;

    public async Task UpdateDatabaseService()
    {
        await _databaseService.UpdateCounts();
    }
}