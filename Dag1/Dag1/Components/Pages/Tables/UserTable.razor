@using Dag1.Infrastructure
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<DbpDag1Context> DbFactory

<Grid TItem="User"
      Class="table table-bordered table-striped"
      Data="Data">
    <Button Color="ButtonColor.Primary" Class="mb-2" @onclick="() => Data.Add(new User())">Add new</Button>
    <GridColumns>
        <GridColumn TItem="User" HeaderText="Id">@context.UserId</GridColumn>
        <GridColumn TItem="User" HeaderText="Name"><TextInput @bind-Value="@context.Name" /></GridColumn>
        <GridColumn Titem="User" HeaderText="Email"><TextInput @bind-Value="@context.Email" /></GridColumn>
        <GridColumn TItem="User" HeaderText="Delete"><Button @onclick="() => DeleteElement(context)"><Icon Name="IconName.Trash" /></Button></GridColumn>
        <GridColumn TItem="User" HeaderText="Save"><Button @onclick="() => SaveElement(context)"><Icon Name="IconName.Save" /></Button></GridColumn>
    </GridColumns>
</Grid>

@code {
    protected override void OnInitialized()
    {
        Data = DataProvider();
        
        base.OnInitialized();
    }

    private List<User> Data { get; set; } = new();

    private List<User> DataProvider()
    {
        using var context = DbFactory.CreateDbContext();
        return context.Users
            .ToList();
    }
    
    private async Task DeleteElement(User item)
    {
        await using var context  = await DbFactory.CreateDbContextAsync();

        context.Users.Remove(item);
        await context.SaveChangesAsync();

        Data = DataProvider();
    }

    private async Task SaveElement(User item)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        if (context.Users.Contains(item))
        {
            context.Users.Update(item);
        }
        else
        {
            context.Users.Add(item);
        }
        await context.SaveChangesAsync();
        
        Data = DataProvider();
    }
}