@using Dag1.Infrastructure
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<DbpDag1Context> DbFactory

<Grid TItem="Author"
      Class="table table-bordered table-striped"
      Data="Data">
    <GridColumns>
        <GridColumn TItem="Author" HeaderText="Name">@context.Author1</GridColumn>
        <GridColumn TItem="Author" HeaderText="Nationality">@context.Nationality</GridColumn>
    </GridColumns>
</Grid>

@code {
    protected override void OnInitialized()
    {
        Data = DataProvider();
        
        base.OnInitialized();
    }

    private List<Author> Data { get; set; } = new List<Author>();
    
    private List<Author> DataProvider()
    {
        using var context = DbFactory.CreateDbContext();
        return context.Authors.ToList();
    }
}