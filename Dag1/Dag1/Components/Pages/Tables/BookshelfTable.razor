@using Dag1.Infrastructure
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<DbpDag1Context> DbFactory

<Grid TItem="Bookshelf"
      Class="table table-bordered table-striped"
      Data="Data">
    <GridColumns>
        <GridColumn TItem="Bookshelf" HeaderText="Id">@context.BookId</GridColumn>
        <GridColumn TItem="Bookshelf" HeaderText="ISBN">@context.Isbn</GridColumn>
        <GridColumn TItem="Bookshelf" HeaderText="Format">@context.Format?.Name</GridColumn>
        <GridColumn TItem="Bookshelf" HeaderText="Borrowed by">@context.BorrowedByNavigation?.Name</GridColumn>
    </GridColumns>
</Grid>

@code {
    protected override void OnInitialized()
    {
        Data = DataProvider();
        
        base.OnInitialized();
    }

    private List<Bookshelf> Data { get; set; } = new();

    private List<Bookshelf> DataProvider()
    {
        using var context = DbFactory.CreateDbContext();
        return context.Bookshelves
            .Include(p => p.Format)
            .Include(p => p.BorrowedByNavigation)
            .ToList();
    }
}